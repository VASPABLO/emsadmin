# Plantilla de variables del backend. Copiá este archivo según el entorno:
#
#   Desarrollo (tu PC con Laragon) -> backend/.env.local
#   Producción (hosting)           -> backend/.env
#
# Ninguno de los dos se versiona en git: cada entorno tiene su propia copia.
# Si existen los dos archivos, .env.local tiene prioridad (solo debería existir
# en tu PC; nunca lo subas al hosting).

# local | production. Si se omite, se detecta por el host
# (localhost, 127.0.0.1, *.test => local; cualquier otro => production).
APP_ENV=local

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=emssoluciones_local
DB_USER=root
DB_PASS=

# URL pública desde la que se sirve este backend, sin barra final.
# Se usa para armar las URLs absolutas de las imágenes que se suben.
# Si se deja vacía o se comenta, se deduce automáticamente del request.
#   Desarrollo: http://localhost:8081/emsadmin/backend
#   Producción: https://emscrsoluciones.com
RUTA_WEB=http://localhost:8081/emsadmin/backend

# Orígenes extra permitidos para CORS, separados por coma (opcional).
# Los dominios de producción ya están permitidos siempre, y en entorno local
# se acepta automáticamente cualquier puerto de localhost/127.0.0.1 y hosts .test.
# CORS_ORIGINS=http://localhost:3000,http://emsadmin.test

# Mostrar el detalle de los errores de conexión en producción (diagnóstico).
# DEBUG=false

# URL del frontend (donde está la pantalla /restablecer), sin barra final.
# Se usa para armar el enlace del correo de "olvidé mi contraseña".
#   Desarrollo: http://localhost:3000
#   Producción: https://emscrsoluciones.com
FRONTEND_URL=http://localhost:3000

# Correo saliente (recuperación de contraseña).
# MAIL_MAILER=log no envía nada: escribe el correo en backend/logs/mail.log.
# MAIL_MAILER=smtp envía de verdad. Ejemplos:
#   Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=tu@gmail.com,
#          MAIL_PASSWORD=<contraseña de aplicación de 16 letras, sin espacios>
#   Hosting (cPanel): MAIL_HOST=mail.emscrsoluciones.com, MAIL_PORT=465,
#          MAIL_USERNAME=no-reply@emscrsoluciones.com, MAIL_PASSWORD=<la del buzón>
# MAIL_SCHEME: tls (587) | smtps (465). Vacío = se deduce del puerto.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@emscrsoluciones.com
MAIL_FROM_NAME="EMS Soluciones"
