# Entorno de DESARROLLO: lo usa "npm start" automáticamente.
# Apache de Laragon escucha en el puerto 8081 (ver C:\laragon\etc\apache2\httpd.conf),
# y el backend se sirve desde C:\laragon\www\emsadmin\backend.
# OJO: el vhost http://emsadmin.test:8081 apunta a la carpeta public/, así que el
# backend NO se alcanza por ahí; hay que usar localhost:8081/emsadmin/backend.
# Para un cambio solo en tu PC (sin tocar git) creá .env.development.local.
REACT_APP_API_URL=http://localhost:8081/emsadmin/backend
